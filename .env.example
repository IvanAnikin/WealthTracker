# Application
APP_NAME=WealthTracker
APP_VERSION=1.0.0
DEBUG=True
SECRET_KEY=your-secret-key-change-this-in-production

# Database
DATABASE_URL=sqlite:///./wealth_tracker.db
# For production PostgreSQL:
# DATABASE_URL=postgresql://user:password@localhost:5432/wealth_tracker

# Open Banking Provider (GoCardless/Nordigen)
GOCARDLESS_SECRET_ID=your-secret-id
GOCARDLESS_SECRET_KEY=your-secret-key
GOCARDLESS_BASE_URL=https://bankaccountdata.gocardless.com/api/v2

# Session
SESSION_SECRET_KEY=your-session-secret-key-change-this
SESSION_COOKIE_NAME=wealth_tracker_session
SESSION_MAX_AGE=86400

# CORS
CORS_ORIGINS=["http://localhost:8000","http://localhost:3000"]

# Sync Schedule (cron expression)
SYNC_SCHEDULE_CRON=0 */6 * * *

# Logging
LOG_LEVEL=INFO
